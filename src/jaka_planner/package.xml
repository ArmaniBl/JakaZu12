<?xml version="1.0"?>
<package format="3">
  <name>jaka_planner</name>
  <version>0.1.0</version>
  <description>JAKA SDK trajectory server for the portable ZU12 workspace.</description>

  <maintainer email="support@example.invalid">JAKA ZU12 workspace maintainer</maintainer>
  <license>Proprietary SDK and upstream package terms apply</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>control_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
