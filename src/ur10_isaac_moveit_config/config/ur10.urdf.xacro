<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur10">
  <xacro:arg name="torch" default="true"/>
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
  <xacro:include filename="welding_torch_isaac.xacro"/>
  <xacro:if value="$(arg torch)">
    <xacro:welding_torch parent="tool0"/>
  </xacro:if>
  <ros2_control name="IsaacUR10" type="system">
    <hardware>
      <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
      <param name="joint_commands_topic">/joint_command</param>
      <param name="joint_states_topic">/joint_states</param>
      <param name="trigger_joint_command_threshold">-1</param>
      <param name="sum_wrapped_joint_states">true</param>
    </hardware>
    <xacro:macro name="controlled_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint name="shoulder_pan_joint"/>
    <xacro:controlled_joint name="shoulder_lift_joint"/>
    <xacro:controlled_joint name="elbow_joint"/>
    <xacro:controlled_joint name="wrist_1_joint"/>
    <xacro:controlled_joint name="wrist_2_joint"/>
    <xacro:controlled_joint name="wrist_3_joint"/>
  </ros2_control>
</robot>
